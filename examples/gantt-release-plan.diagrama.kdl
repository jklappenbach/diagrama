diagram type="gantt" title="Release plan — v1 launch" mode="calendar" {
    calendar start="2026-07-01" unit="hour" hours-per-day=8 workweek="mon-fri"
    palette "pastel"

    lane "be"  label="Backend"
    lane "fe"  label="Frontend"
    lane "ops" label="Platform"

    start "start" label="Start"                          // star root (implicit if omitted)

    task "spec" title="Spec & API design" cost=16 lane="be" ticket="JIRA-1200" {
        desc "Endpoints, schema, error model"
        deps "start"
    }
    task "api" title="Build API" cost=40 lane="be" ticket="JIRA-1234" ticket-url="https://jira/browse/JIRA-1234" {
        deps "spec"
    }
    task "ui" title="Build UI" cost=36 lane="fe" ticket="JIRA-1240" {
        deps "spec"
    }
    task "infra" title="Provision infra" cost=12 lane="ops" ticket="JIRA-1250" {
        deps "start"
    }
    task "integ" title="Integration" cost=20 lane="be" ticket="JIRA-1260" {
        deps "api" "ui" "infra"                          // waits on all three; end calculated
    }
    task "uat" title="UAT + fixes" cost=24 lane="fe" ticket="JIRA-1270" {
        deps "integ"
    }
    task "ga" title="GA cutover" cost=4 lane="ops" ticket="JIRA-1299" {
        deps "uat"
    }
}
